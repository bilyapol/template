# All fields are optional in development — the app boots with zero config.
# Just run: cp .env.example .env && ./dev.sh

# Environment: development (default) or production.
# Production refuses to start with a weak JWT_SECRET or non-https FRONTEND_URL,
# disables dev login, and marks cookies Secure.
# APP_ENV=development

# Database (default: local docker postgres on port 5433)
# DATABASE_URL=postgres://app:app@localhost:5433/app

# JWT (dev default is insecure; production requires 32+ random chars: openssl rand -hex 32)
# JWT_SECRET=
# JWT_EXPIRY_SECONDS=86400

# Google OAuth (optional — when absent, dev-mode email login is enabled in development)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Rate limiting: trust X-Forwarded-For for the client IP.
# Set to true ONLY behind a reverse proxy (Railway, Fly, nginx).
# TRUST_PROXY=false

# Server
# FRONTEND_URL=http://localhost:5173
# PORT=3000
